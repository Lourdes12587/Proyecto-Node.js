<%- include('partials/head') %>

<%- include('partials/header') %>

<link rel="stylesheet" href="/resources/css/ganadores.css">

<main class="auth-wrapper winners-admin-page">
  <section class="winners-admin-shell" aria-label="Registro de ganadores">
    <div class="winners-visual-panel" aria-hidden="true">
      <div class="winners-mark">
        <span>25</span>
        <strong>RACE</strong>
      </div>

      <div class="podium-grid">
        <div class="podium-card podium-second">
          <span>02</span>
          <strong>PACE</strong>
        </div>
        <div class="podium-card podium-first">
          <span>01</span>
          <strong>WIN</strong>
        </div>
        <div class="podium-card podium-third">
          <span>03</span>
          <strong>CREW</strong>
        </div>
      </div>
    </div>

    <div class="login-container winners-form-card">
      <span class="winners-kicker">Podium control</span>
      <h2>Registrar Ganadores</h2>
      <p class="helper small mb-2">Introduce el numero de dorsal de los 3 primeros clasificados</p>

      <% if (mensaje) { %>
        <div class="form-alert <%= mensajeTipo === 'success' ? 'success' : '' %>"><%= mensaje %></div>
      <% } %>

      <form action="/ganadores" method="post" class="mt-2">
        <input type="hidden" name="origen" value="admin" />

        <div class="winner-field winner-field-first">
          <label for="primero">1er Clasificado (dorsal)</label>
          <input type="number" id="primero" name="primero" min="1" required />
        </div>

        <div class="winner-field">
          <label for="segundo">2do Clasificado (dorsal)</label>
          <input type="number" id="segundo" name="segundo" min="1" required />
        </div>

        <div class="winner-field">
          <label for="tercero">3er Clasificado (dorsal)</label>
          <input type="number" id="tercero" name="tercero" min="1" required />
        </div>

        <div class="form-actions">
          <button type="submit" class="cta-btn">GUARDAR <i class="bx bx-check-circle" aria-hidden="true"></i></button>
          <a href="/admin" class="btn-neutral">Cancelar</a>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
