<%- include('partials/head') %>

<%- include('partials/header') %>

<main class="editorial-page">
  <section class="editorial-hero" aria-label="Happy Runner 42K">
    <div class="editorial-wrap campaign-grid">
      <article class="hero-card">
        <div class="hero-topline">
          <div class="hero-number">28</div>
          <p class="microcopy">Happy Runner Club. Barcelona street race. 42K distance. Park Guell start.</p>
          <div class="hero-year-wrap">
            <div class="circle-mark">C</div>
            <div class="hero-year">25</div>
          </div>
        </div>

        <figure class="hero-image">
          <img src="/resources/img/jovenes-amigos-corriendo-durante-una-maraton.jpg" alt="Runners en movimiento durante la carrera">
          <figcaption class="image-caption">
            <span>Movement culture in motion</span>
            <span>Barcelona 42K</span>
          </figcaption>
        </figure>

        <div class="hero-actions" role="group" aria-label="Acciones principales">
          <a href="/inscripcion" class="run-button primary">Inscripcion <span>-></span></a>
          <a href="#recorrido" class="run-button">Ver recorrido <span>-></span></a>
        </div>
      </article>

      <div class="campaign-column">
        <article class="campaign-panel">
          <h2>Run&<br>Race</h2>
          <p><span class="panel-kicker">25 Race</span>Una experiencia urbana de resistencia, ritmo y comunidad para corredores que buscan algo mas que una meta.</p>
        </article>

        <article class="mini-card">
          <div class="mini-card__text">
            <span>Register</span>
            <p>Our runners are designed to push you further. Energize, inspire and connect.</p>
          </div>
          <img src="/resources/img/happy (1).png" alt="Detalle visual de Happy Runner">
        </article>

        <article class="mini-card">
          <div class="mini-card__text">
            <span>42K Barcelona</span>
            <p>Park Guell start. Urban rhythm. Official kit. Hydration points every stage.</p>
          </div>
          <img src="/resources/img/mujeres-atleticas-felices-apoyandose-mutuamente-mientras-corren-un-maraton-en-la-naturaleza (1).jpg" alt="Corredoras celebrando">
        </article>
      </div>
    </div>
  </section>

  <section class="ticker" aria-label="Fechas del evento">
    <div class="ticker-track">
      <span>29 Nov 2025</span><span>Happy Runner</span><span>42K Barcelona</span><span>Park Guell</span><span>Official Race</span>
      <span>29 Nov 2025</span><span>Happy Runner</span><span>42K Barcelona</span><span>Park Guell</span><span>Official Race</span>
    </div>
  </section>

  <section class="statement-section" aria-label="Identidad de comunidad">
    <div class="editorial-wrap statement-panel">
      <div class="statement-title">
        <span>Our City</span>
        <span>Our Pace</span>
        <span>Our Crew</span>
      </div>
      <div class="statement-side">
        <div class="arrow-mark">-></div>
        <p>La carrera cruza la ciudad como una declaracion de energia colectiva: entrenamiento, cultura urbana y comunidad runner.</p>
      </div>
    </div>
  </section>

  <section class="modules-section" id="info">
    <div class="editorial-wrap modules-grid">
      <article class="info-module large">
        <span class="module-kicker">Event briefing</span>
        <h2>Informacion del Evento</h2>
        <p>Todo lo necesario para preparar la carrera: horarios, salida, servicios, categorias y recorrido oficial.</p>
      </article>

      <div class="info-module medium">
        <div class="detail-grid">
          <article>
            <h3>Fecha</h3>
            <p>29 de noviembre 2025</p>
          </article>
          <article>
            <h3>Hora</h3>
            <p>10:00 AM salida por olas</p>
          </article>
          <article>
            <h3>Ubicacion</h3>
            <p>Park Guell salida. Meta zona centro.</p>
          </article>
          <article>
            <h3>Hidratacion</h3>
            <p>Avituallamiento cada 5 km y zona de meta.</p>
          </article>
        </div>
      </div>

      <section class="info-module small" id="categorias">
        <span class="module-kicker">Race classes</span>
        <h3>Categorias</h3>
        <div class="categories-grid editorial-cats">
          <article>
            <h3>Masculina 42K</h3>
            <p>Trofeos y premios por puesto y edad.</p>
          </article>
          <article>
            <h3>Femenina 42K</h3>
            <p>Trofeos y premios por puesto y edad.</p>
          </article>
        </div>
      </section>

      <section class="gallery-panel" aria-label="Galeria">
        <figure>
          <img src="/resources/img/corredores-alegres-divirtiendose-mientras-participan-en-una-carrera-en-la-naturaleza.jpg" alt="Corredores en ruta" loading="lazy">
          <figcaption>Route energy</figcaption>
        </figure>
        <figure>
          <img src="/resources/img/diferentes-personas-participando-en-un-campo-traves.jpg" alt="Salida oficial" loading="lazy">
          <figcaption>Start line</figcaption>
        </figure>
        <figure>
          <img src="/resources/img/mujeres-atleticas-felices-apoyandose-mutuamente-mientras-corren-un-maraton-en-la-naturaleza (1).jpg" alt="Meta de corredores" loading="lazy">
          <figcaption>Finish culture</figcaption>
        </figure>
      </section>

    </div>
  </section>
</main>

<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

<%- include('partials/footer') %>
