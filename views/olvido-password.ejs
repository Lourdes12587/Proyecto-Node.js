<%- include('partials/head') %>

<%- include('partials/header') %>

  <link rel="stylesheet" href="/resources/css/olvido-password.css">

<div class="container page-body">
  <section class="card">
    <h2>Olvidé mi contraseña</h2>
    <% if (mensaje) { %>
      <div class="form-alert"><%= mensaje %></div>
    <% } %>

    <form action="/olvido-password" method="post">
      <label for="email">Correo electrónico:</label>
      <input type="email" name="email" id="email" required />
      <button type="submit" class="cta-btn">Enviar enlace</button>
    </form>
  </section>
</div>

<%- include('partials/footer') %>

