<%- include('partials/head') %>

  <%- include('partials/header') %>

  <link rel="stylesheet" href="/resources/css/login.css">
  <link rel="stylesheet" href="/resources/css/editorial-running.css">

<main class="auth-wrapper editorial-auth login-admin-page">
    <form class="login-container" action="/authadmin" method="POST">
      <h2>ADMINISTRADORES</h2>
      <label for="user">Ingrese su usuario:</label>
      <input type="text" name="user" id="user" placeholder="Ingrese su usuario">

      <label for="password">Ingrese su contraseña:</label>
      <input type="password" name="password" id="password" placeholder="Ingrese su contraseña">

      <button type="submit">INGRESAR</button>
    </form>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <% if (typeof alert != 'undefined') { %>
  <script>
    Swal.fire({
      title: '<%= alertTitle %>',
      text: '<%= alertMessage %>',
      icon: '<%= alertIcon %>',
      background: '#f4f1e8',
      color: '#050505',
      iconColor: '#ff4f18',
      confirmButtonText: 'Aceptar',
      confirmButtonColor: '#ff4f18',
      showCloseButton: true,
      showCancelButton: false,
      showConfirmButton: <%= showConfirmButton %>,
      timer: <%= timer %>,
      backdrop: 'rgba(5,5,5,0.78)',
      customClass: {
        popup: 'run-alert-popup',
        title: 'run-alert-title',
        htmlContainer: 'run-alert-content',
        confirmButton: 'run-alert-confirm',
        closeButton: 'run-alert-close'
      }
      }).then(() => {
      window.location = '/<%= ruta %>';
      });
  </script>
  <% } %>
  </main>

  <%- include('partials/footer') %>
  
